<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <conversionRule conversionWord="msg" class="dev.foliopay.logging.PanMaskingConverter"/>
  <conversionRule conversionWord="maskedEx" class="dev.foliopay.logging.MaskingThrowableConverter"/>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{20} - %msg%n%maskedEx</pattern></encoder>
  </appender>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
