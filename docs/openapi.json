          },
          "config" : {
            "$ref" : "#/components/schemas/ShadowConfig"
          },
          "bookings" : {
            "type" : "integer",
            "format" : "int32"
          },
          "matched" : {
            "type" : "integer",
            "format" : "int32"
          },
          "mismatched" : {
            "type" : "integer",
