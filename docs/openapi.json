            "format" : "int64"
          },
          "currency" : {
            "type" : "string"
          },
          "dueDate" : {
            "type" : "string",
            "format" : "date"
          },
          "reason" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "OPEN", "PAYING", "PAID", "CANCELLED", "SUPERSEDED" ]
          }
        }
      },
      "VaultRow" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string"
          },
