          },
          "operaRef" : {
            "type" : "string"
          },
          "failureCategory" : {
            "type" : "string",
            "enum" : [ "OPERA_UNAVAILABLE", "REJECTED_BY_OPERA" ]
          },
          "lastError" : {
            "type" : "string"
          },
          "attempts" : {
            "type" : "integer",
            "format" : "int32"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "PayRequest" : {
        "type" : "object",
        "properties" : {
          "idempotencyKey" : {
            "type" : "string",
            "description" : "Client-chosen key. Repeating it returns the first result; never charges twice.",
            "example" : "order-7731-attempt-1",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(?!link:|post:|shadow-)[A-Za-z0-9:_.-]+"
          },
          "bookingRef" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "[A-Za-z0-9._-]{1,64}"
          },
          "folioId" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "[A-Za-z0-9._-]{1,64}"
          },
          "token" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "tok_[a-f0-9]{32}"
          },
          "amountMinor" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Amount in minor units (cents)",
            "example" : 12345,
            "maximum" : 1000000000000,
            "minimum" : 1
          },
          "currency" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "[A-Z]{3}"
          },
          "businessDate" : {
            "type" : "string",
            "format" : "date",
            "description" : "Optional. Must equal the hotel's current business date from the PMS; the server fills it in when omitted"
          }
        },
        "required" : [ "bookingRef", "currency", "folioId", "idempotencyKey", "token" ]
      },
      "ChargeView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "idempotencyKey" : {
            "type" : "string"
          },
          "bookingRef" : {
            "type" : "string"
          },
          "amountMinor" : {
            "type" : "integer",
            "format" : "int64"
          },
          "currency" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "CAPTURED", "DECLINED" ]
          },
          "pspRef" : {
            "type" : "string"
          },
          "lastError" : {
            "type" : "string"
          },
          "attempts" : {
            "type" : "integer",
            "format" : "int32"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
