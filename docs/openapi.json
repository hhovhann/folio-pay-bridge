            "maxLength" : 200000,
            "minLength" : 0
          }
        }
      },
      "Item" : {
        "type" : "object",
        "properties" : {
          "category" : {
            "type" : "string",
            "enum" : [ "MISSING_IN_SETTLEMENT", "AMOUNT_DIFFERENCE", "CURRENCY_DIFFERENCE", "UNKNOWN_IN_SETTLEMENT", "DUPLICATE_IN_SETTLEMENT", "NOT_POSTED_TO_PMS" ]
