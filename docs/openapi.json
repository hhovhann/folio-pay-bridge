{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Folio Pay Bridge API",
    "description" : "Concept pilot: tokenise virtual cards, charge them once per idempotency key, post to the guest folio, turn booking events into payment links, and reconcile against an acquirer statement. Synthetic data only: the processor and the PMS are in-memory fakes. Card numbers are accepted only by POST /api/cards and are never returned. Money is an integer in minor units (cents) plus an ISO 4217 currency.",
    "license" : {
      "name" : "Concept pilot, not for production use"
    },
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "Cards",
    "description" : "Tokenisation. The only endpoint that accepts a card number."
  }, {
    "name" : "Payments",
    "description" : "Charge a tokenised card, post to the folio, inspect the ledger, replay dead-lettered postings."
  }, {
    "name" : "Demo",
    "description" : "Present only when foliopay.demo-controls=true."
  }, {
    "name" : "Reconciliation",
    "description" : "Revenue assurance against an acquirer settlement statement."
  }, {
    "name" : "Payment links",
    "description" : "Booking events become payment requests under the written policy; the guest pays a link."
  } ],
  "paths" : {
    "/api/sim" : {
      "get" : {
        "tags" : [ "Demo" ],
        "summary" : "Simulator state",
        "operationId" : "state",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SimState"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Demo" ],
        "summary" : "Arm a fault or reset the fakes",
        "operationId" : "apply",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SimRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SimState"
                }
              }
            }
          }
        }
      }
    },
    "/api/shadow" : {
      "post" : {
        "tags" : [ "Demo" ],
        "summary" : "Run shadow mode",
        "description" : "Replays synthetic bookings through the payment flow and compares each with the legacy stand-in.",
        "operationId" : "run",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ShadowRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShadowReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/reconcile" : {
      "post" : {
        "tags" : [ "Reconciliation" ],
        "summary" : "Reconcile",
        "description" : "With csv (header psp_ref,amount_minor) reconciles that statement; without it, the acquirer's own statement. Exceptions: MISSING_IN_SETTLEMENT, AMOUNT_DIFFERENCE, UNKNOWN_IN_SETTLEMENT, DUPLICATE_IN_SETTLEMENT, NOT_POSTED_TO_PMS.",
        "operationId" : "reconcile",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ReconcileRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReconReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/postings/{id}/replay" : {
      "post" : {
        "tags" : [ "Payments" ],
        "summary" : "Replay a posting",
        "description" : "Tries a dead-lettered posting again. A posting rejected by the PMS is returned untouched; an outage can be replayed. Safe to repeat.",
        "operationId" : "replay",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PostingView"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments" : {
      "post" : {
        "tags" : [ "Payments" ],
        "summary" : "Pay",
        "description" : "Idempotent on idempotencyKey: repeating a request returns the first result and never charges twice. The same key with different parameters is 409. The outcome says which half happened: OK, DECLINED, CHARGE_PENDING (retry with the same key), CHARGED_NOT_POSTED (captured, waiting in the dead-letter queue).",
        "operationId" : "pay",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PayRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/links/{id}/pay" : {
      "post" : {
        "tags" : [ "Payment links" ],
        "summary" : "Pay a link",
        "description" : "Charges the link amount. The idempotency key is per link and card: a double-click is one charge; a different card after a decline is a new attempt. 410 when the link is cancelled or superseded.",
        "operationId" : "pay_1",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LinkPayRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cards" : {
      "post" : {
        "tags" : [ "Cards" ],
        "summary" : "Tokenise a card",
        "description" : "Returns a token and the display digits (first six, last four). The number is never returned or stored in clear.",
        "operationId" : "tokenise",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CardRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/booking-events" : {
      "post" : {
        "tags" : [ "Payment links" ],
        "summary" : "Handle a booking event",
        "description" : "NEW and MODIFIED create or supersede the open payment request; CANCELLED closes it and flags a refund review when it was already paid. Repeating an event changes nothing.",
        "operationId" : "event",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BookingEventRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingOutcomeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/vault" : {
      "get" : {
        "tags" : [ "Demo" ],
        "summary" : "What the vault stores",
        "description" : "Ciphertext previews and display digits only.",
        "operationId" : "vault",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/VaultRow"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/postings" : {
      "get" : {
        "tags" : [ "Payments" ],
        "summary" : "List folio postings",
        "operationId" : "postings",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PostingView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/logs" : {
      "get" : {
        "tags" : [ "Demo" ],
        "summary" : "Masked log tail",
        "operationId" : "logs",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "type" : "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/links" : {
      "get" : {
        "tags" : [ "Payment links" ],
        "summary" : "List payment links",
        "operationId" : "links",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/LinkView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/charges" : {
      "get" : {
        "tags" : [ "Payments" ],
        "summary" : "List charges",
        "operationId" : "charges",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ChargeView"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
