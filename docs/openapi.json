          },
          "byField" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "samples" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Mismatch"
            }
          },
