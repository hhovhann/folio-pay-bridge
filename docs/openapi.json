              "$ref" : "#/components/schemas/Item"
            }
          },
          "expectedMinor" : {
            "type" : "integer",
            "format" : "int64"
          },
          "settledMinor" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "PostingView" : {
