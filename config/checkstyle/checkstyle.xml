<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  The rules of docs/engineering-standards.md section 3 that a standard tool checks (phase 22), over src/main and src/test, in the
  validate phase of every build. Code that broke a size limit before the limit was checked says so where it is, with
  @SuppressWarnings("checkstyle:MethodLength") or ("checkstyle:ParameterNumber"); a file over the limit is named in suppressions.xml.
  Each exception may only be removed.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="SuppressWarningsFilter"/>
  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.suppressions.file}"/>
  </module>

  <!-- A file is at most 350 lines: more is a second responsibility waiting for its own class. -->
  <module name="FileLength">
    <property name="max" value="350"/>
  </module>
  <!-- New code stays under 150 characters a line (Google's 100 is left to a formatter, roadmap Next 6). -->
  <module name="LineLength">
    <property name="max" value="150"/>
    <property name="ignorePattern" value="^(package|import) "/>
  </module>

  <module name="TreeWalker">
    <module name="SuppressWarningsHolder"/>

    <!-- Imports: sorted, static first, no wildcard, none unused or repeated. -->
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="CustomImportOrder">
      <property name="customImportOrderRules" value="STATIC###THIRD_PARTY_PACKAGE"/>
      <property name="sortImportsInGroupAlphabetically" value="true"/>
      <property name="separateLineBetweenGroups" value="true"/>
    </module>

    <!-- Braces on every if, else, for, while and do: a second statement added later cannot escape the condition. -->
    <module name="NeedBraces"/>

    <!-- A method body is at most 30 lines and a method takes at most 4 parameters (constructors list collaborators and are exempt). -->
    <module name="MethodLength">
      <property name="max" value="30"/>
      <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="4"/>
      <property name="ignoreOverriddenMethods" value="true"/>
      <property name="tokens" value="METHOD_DEF"/>
    </module>

    <!-- A class used by its full name in code hides a dependency from the imports (and from ArchitectureTest). JPQL strings excepted. -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="FullyQualifiedName"/>
      <property name="format" value="^(?!\s*(import|package) )[^&quot;]*(?&lt;![\w.])(java|javax|jakarta|org|com|dev|io|software)\.[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*\.[A-Z]\w*"/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Import the class instead of writing it out in full (standards section 3)."/>
    </module>
  </module>
</module>
