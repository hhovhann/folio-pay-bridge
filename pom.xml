<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>dev.foliopay</groupId>
  <artifactId>folio-pay-bridge</artifactId>
  <version>0.2.0</version>
  <name>folio-pay-bridge</name>
  <description>Hotel payments slice: virtual-card charging and folio posting, PCI-minded, with shadow mode against a legacy stand-in</description>
  <properties>
    <java.version>17</java.version>
    <awssdk.version>2.59.1</awssdk.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <springdoc.version>2.10.0</springdoc.version>
    <jacoco.version>0.8.16</jacoco.version>
    <!-- The operator dashboard (dashboard/, React + TypeScript) is built and tested with a pinned Node by frontend-maven-plugin. -->
    <frontend-plugin.version>1.15.4</frontend-plugin.version>
    <node.version>v22.12.0</node.version>
    <!-- Raised above Spring Boot's managed versions to what the libraries using them were built against (the enforcer's
         requireUpperBoundDeps, agent log 50): httpclient5/httpcore5 for the AWS SDK's apache5-client (KmsWireTest runs the real KMS
         client over HTTP), snakeyaml and commons-lang3 for springdoc (OpenApiContractTest). Minor versions, same major. Remove each
         line once Spring Boot manages that version or a newer one. -->
    <httpclient5.version>5.6.4</httpclient5.version>
    <httpcore5.version>5.4.3</httpcore5.version>
    <snakeyaml.version>2.6</snakeyaml.version>
    <commons-lang3.version>3.21.0</commons-lang3.version>
    <skipDashboard>false</skipDashboard>
    <skipDashboardTests>${skipDashboard}</skipDashboardTests>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <!-- Approved by the owner 2026-11-18: authentication by OAuth2 client credentials (JWT) or scoped API keys; schema migrations. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-oauth2-resource-server</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>${springdoc.version}</version></dependency>
    <dependency><groupId>io.github.resilience4j</groupId><artifactId>resilience4j-retry</artifactId><version>${resilience4j.version}</version></dependency>
    <!-- KMS through the synchronous client only (KmsConfig): the SDK's async Netty client is excluded. It was unused, and it pulled Netty
         at a newer version than Spring Boot manages, which the enforcer's requireUpperBoundDeps rule reported (agent log 50). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>kms</artifactId>
      <exclusions><exclusion><groupId>software.amazon.awssdk</groupId><artifactId>netty-nio-client</artifactId></exclusion></exclusions>
    </dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- No jar hell: every library resolves to one version, never older than one that asked for it, on the Java and Maven the build
             expects. Fails at validate, before anything compiles. The version is the one Spring Boot manages. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-jar-hell</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
                <requireUpperBoundDeps/>
                <banDuplicatePomDependencyVersions/>
                <requireJavaVersion><version>[17,18)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Builds dashboard/ into target/classes/static/dashboard (served at /dashboard/) and runs its tests in the test phase.
             -DskipDashboard=true skips all of it for a fast backend-only loop; -DskipDashboardTests=true skips only its tests. -->
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>${frontend-plugin.version}</version>
        <configuration>
          <workingDirectory>dashboard</workingDirectory>
          <installDirectory>target/node</installDirectory>
          <skip>${skipDashboard}</skip>
        </configuration>
        <executions>
          <execution>
            <id>install-node</id>
            <goals><goal>install-node-and-npm</goal></goals>
            <configuration><nodeVersion>${node.version}</nodeVersion></configuration>
          </execution>
          <execution>
            <id>npm-ci</id>
            <goals><goal>npm</goal></goals>
            <configuration><arguments>ci --no-audit --no-fund</arguments></configuration>
          </execution>
          <execution>
            <id>dashboard-build</id>
            <phase>generate-resources</phase>
            <goals><goal>npm</goal></goals>
            <configuration><arguments>run build</arguments></configuration>
          </execution>
          <execution>
            <id>dashboard-test</id>
            <phase>test</phase>
            <goals><goal>npm</goal></goals>
            <configuration><arguments>test</arguments><skip>${skipDashboardTests}</skip></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <!-- only the two main() entry points: starting a whole server from a unit test proves nothing -->
          <excludes>
            <exclude>dev/foliopay/FolioPayApplication.class</exclude>
            <exclude>dev/foliopaysim/SimulatorApplication.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution><id>agent</id><goals><goal>prepare-agent</goal></goals></execution>
          <!-- the report is written at the end of `./mvnw test`: target/site/jacoco/index.html and jacoco.csv -->
          <execution><id>report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
          <!-- `./mvnw verify` (CI) fails if coverage drops below the gate -->
          <execution>
            <id>gate</id><phase>verify</phase><goals><goal>check</goal></goals>
            <configuration>
              <rules><rule><element>BUNDLE</element><limits>
                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.99</minimum></limit>
                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
              </limits></rule></rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!-- the jar also holds the simulators (dev.foliopaysim.SimulatorApplication, started through PropertiesLauncher in compose.yaml) -->
        <configuration><mainClass>dev.foliopay.FolioPayApplication</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
</project>
