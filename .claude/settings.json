{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.aws/**)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(aws kms decrypt:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force-with-lease:*)",
      "Bash(git push origin +*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push * :*)",
      "Bash(git push -d *)",
      "Bash(git push * --delete *)",
      "Bash(git push --mirror*)",
      "Bash(git clean -f*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(docker push:*)",
      "Bash(aws:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/guard_secrets.py --hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/guard_commands.py --hook"
          }
        ]
      }
    ]
  }
}
